{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(wc:*)",
      "Bash(find:*)",
      "WebSearch",
      "Bash(uv sync:*)",
      "WebFetch(domain:docs.firecrawl.dev)",
      "Bash(uv run mypy:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run:*)",
      "WebFetch(domain:docs.cloud.google.com)",
      "WebFetch(domain:docs.astral.sh)",
      "Bash(docker logs:*)",
      "Bash(.venv/bin/pip list:*)",
      "Bash(curl:*)",
      "Bash(docker exec:*)",
      "Bash(docker compose:*)",
      "WebFetch(domain:discuss.google.dev)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:docs.unstructured.io)",
      "WebFetch(domain:www.reducto.ai)",
      "WebFetch(domain:developers.llamaindex.ai)",
      "WebFetch(domain:procycons.com)",
      "Bash(grep:*)",
      "WebFetch(domain:docs.crawl4ai.com)",
      "WebFetch(domain:blog.apify.com)",
      "WebFetch(domain:scrapeops.io)",
      "Bash(xargs basename:*)",
      "WebFetch(domain:playwright.dev)",
      "WebFetch(domain:api.opensustainabilityindex.org)",
      "WebFetch(domain:opensustainabilityindex.org)",
      "WebFetch(domain:crawl4ai.com)",
      "WebFetch(domain:www.upm.com)",
      "Bash(/usr/bin/du:*)",
      "Bash(cat:*)",
      "Bash(docker system df:*)",
      "Bash(ls:*)",
      "Bash(uv lock:*)",
      "WebFetch(domain:www.storaenso.com)",
      "Bash(docker ps:*)",
      "Bash(done)",
      "Bash(.venv/bin/python:*)",
      "WebFetch(domain:docs.litellm.ai)",
      "Bash(TEXTUAL_PRESS_KEYS='q' timeout 3 uv run python:*)",
      "Bash(timeout 120 docker logs:*)",
      "WebFetch(domain:dylancastillo.co)",
      "WebFetch(domain:discuss.ai.google.dev)",
      "WebFetch(domain:python.useinstructor.com)",
      "Bash(git mv:*)",
      "WebFetch(domain:pymupdf.readthedocs.io)",
      "Bash(PGPASSWORD=junipr psql:*)",
      "Bash(TEXTUAL_PRESS_KEYS='2,down,q' timeout 5 uv run python:*)",
      "Bash(echo:*)",
      "Bash(uv add:*)",
      "Bash(git grep:*)",
      "WebFetch(domain:www.githubstatus.com)",
      "WebFetch(domain:ai.google.dev)",
      "WebFetch(domain:medium.com)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(make format:*)",
      "Bash(timeout 120 uv run python:*)",
      "Bash(timeout 180 uv run python:*)",
      "Bash(timeout 300 uv run:*)",
      "Bash(docker stats:*)",
      "Bash(make migrate:*)",
      "Bash(make lint:*)",
      "WebFetch(domain:docs.dagster.io)",
      "WebFetch(domain:docling-project.github.io)",
      "WebFetch(domain:arxiv.org)",
      "Bash(make typecheck:*)",
      "Bash(timeout 10 docker logs:*)",
      "Bash(timeout 15 docker logs:*)",
      "Bash(head:*)",
      "Bash(alembic history:*)",
      "Bash(git rm:*)",
      "Bash(git checkout:*)",
      "Bash(jq:*)",
      "Bash(tree:*)",
      "Bash(git rebase:*)",
      "Bash(git tag:*)",
      "Bash(make test-unit:*)",
      "Bash(git merge:*)",
      "Bash(git log:*)",
      "Bash(timeout 10 uv run:*)",
      "Bash(timeout 15 uv run:*)",
      "WebFetch(domain:skywork.ai)",
      "WebFetch(domain:evli-website.files.svdcdn.com)"
    ],
    "deny": [
      "Bash(sed:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/docket-guard-ledger.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "npx -y ccstatusline@latest",
    "padding": 0
  },
  "enabledPlugins": {
    "frontend-design-pro@frontend-design-pro": false,
    "frontend-design@claude-code-plugins": false,
    "frontend-design@claude-plugins-official": false,
    "gopls-lsp@claude-plugins-official": false,
    "ponytail@ponytail": true,
    "rust-analyzer-lsp@claude-plugins-official": false,
    "superpowers@claude-plugins-official": true,
    "curt@curt": true,
    "codex@openai-codex": true,
    "docket@NovusEdge": true,
    "readable-responses@readable-responses": true
  },
  "extraKnownMarketplaces": {
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "curt": {
      "source": {
        "source": "github",
        "repo": "NovusEdge/curt"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "NovusEdge": {
      "source": {
        "source": "github",
        "repo": "NovusEdge/docket"
      }
    },
    "readable-responses": {
      "source": {
        "source": "github",
        "repo": "NovusEdge/readable-responses"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "low",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "medium"
    },
    "claude-opus-4-8": {
      "effortLevel": "medium"
    },
    "claude-opus-4-5": {
      "effortLevel": "medium"
    },
    "claude-fable-5": {
      "effortLevel": "high"
    },
    "claude-fable-5-1": {
      "effortLevel": "high"
    }
  },
  "promptSuggestionEnabled": false,
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "autoCompactEnabled": true,
  "teammateMode": "auto",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "autoMode": {
    "environment": [
      "### Org-wide",
      "**Organization**: None configured",
      "**Cloud provider(s)**: None configured",
      "**Repository visibility**: Public — `NovusEdge/NovusEdge.github.io` (confirmed via gh)",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: None configured",
      "**Default / protected branches**: Default branch `main`; no branch protection rules or rulesets listed (gh) — treat `main` as unprotected but exercise normal care with force-pushes",
      "**CI/CD deploy targets**: None configured",
      "**Network posture**: None configured",
      "**Source control**: The trusted repo and its remotes only — `origin` (github.com:NovusEdge/NovusEdge.github.io.git) and `rad` (rad://z25HyLeWVPmKceFRSAQweMooCirD8, seed.radicle.xyz)",
      "**Trusted internal domains**: None configured",
      "**Trusted cloud buckets**: None configured",
      "**Key internal services**: None configured",
      "**Internal package registry**: None configured",
      "**Sensitive data locations & audiences**: any file or store holding personal data, confidential business data, credentials, regulated data, or similarly sensitive material; preserve exact handles when known and share only with audiences cleared at the [named+specifics] bar. Note: `.env`, `.env.*` (excluding `.env.example`) are gitignored in this repo — treat as secret-bearing",
      "**Data retention / declassification**: None configured",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries `prod` or `production` as a whole word or name segment",
      "**Protected deployment namespaces / environments**: None configured — fall back to the Sensitive remote targets heuristic",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries `prod` or `production` as a whole word or name segment",
      "### User-specific",
      "**Primary use of Claude Code**: software development — this repo is a public GitHub Pages / static site project (NovusEdge.github.io)",
      "**Trusted repo**: `/home/novusedge/Projects/Personal/NovusEdge.github.io` and its remotes `origin` (github.com:NovusEdge/NovusEdge.github.io.git, public) and `rad` (rad://z25HyLeWVPmKceFRSAQweMooCirD8). Public repo: only this repo's own work belongs here — content ported or first read from outside this session's repo is not its own work. Secrets and sensitive data are never cleared into it by visibility alone",
      "**Org-specific CLIs**: None configured"
    ]
  },
  "voiceEnabled": true
}
